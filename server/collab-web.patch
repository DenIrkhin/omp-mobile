+
+const LINK = `roomroomroom1234#${encodeBase64Url(new Uint8Array(32))}`;
+const HEADER: SessionHeader = { type: "session", id: "s1", timestamp: "2026-06-12T00:00:00Z", cwd: "/work" };
+const STATE: SessionState = { isStreaming: false, queuedMessageCount: 0, cwd: "/work", participants: [] };
+
+function entry(id: string, text: string): SessionEntry {
+	return {
+		type: "message",
+		id,
+		parentId: null,
+		timestamp: "2026-06-12T00:00:01Z",
+		message: { role: "user", content: text, timestamp: 1 },
+	};
+}
+
+function welcome(entryCount: number, header = HEADER): HostFrame {
+	return { t: "welcome", proto: COLLAB_PROTO, header, state: STATE, agents: [], entryCount };
+}
+
+/** In-memory store. `release` hands the client its saved copy and returns once the client applied it. */
+function memoryStore(saved: CachedTranscript | null) {
+	const loadCalled = Promise.withResolvers<void>();
+	const loaded = Promise.withResolvers<CachedTranscript | null>();
+	const firstSave = Promise.withResolvers<void>();
+	const saves: CachedTranscript[] = [];
+	const store: TranscriptStore = {
+		load: () => {
+			loadCalled.resolve();
+			return loaded.promise;
+		},
+		save: async (_roomId, _key, transcript) => {
+			saves.push(transcript);
+			firstSave.resolve();
+		},
+	};
+	const release = async (): Promise<void> => {
+		await loadCalled.promise;
+		loaded.resolve(saved);
+		// The client awaited this same promise first, so its continuation has run.
+		await loaded.promise;
+	};
+	return { store, saves, firstSave: firstSave.promise, release };
+}
+
+const CHAT = (sessionId: string, bytes: number, usedAt: number): CachedChatInfo => ({
+	sessionId,
+	roomId: `room-${sessionId}`,
+	bytes,
+	usedAt,
+});
+
+describe("chatsToEvict", () => {
+	const limits = { maxChats: 2, maxTotalBytes: 100, maxChatBytes: 100 };
+
+	it("keeps the most recently used chats up to the count", () => {
+		const chats = [CHAT("old", 1, 1), CHAT("new", 1, 3), CHAT("mid", 1, 2)];
+		expect(chatsToEvict(chats, limits)).toEqual(["old"]);
+	});
+
+	it("evicts every older chat once the byte total is reached", () => {
+		// "mid" does not fit next to "new"; the smaller "old" goes too, so order stays strict LRU.
+		const chats = [CHAT("old", 10, 1), CHAT("mid", 60, 2), CHAT("new", 50, 3)];
+		expect(chatsToEvict(chats, limits)).toEqual(["mid", "old"]);
+	});
+});
+
+describe("sealed transcripts", () => {
+	const transcript: CachedTranscript = { sessionId: "s1", header: HEADER, entries: [entry("e1", "secret words")] };
+
+	it("round-trips with the room key and stores no plaintext", async () => {
+		const key = await importRoomKey(generateRoomKey());
+		const sealed = await sealTranscript(key, transcript);
+		if (sealed === null) throw new Error("expected a sealed transcript");
+		expect(new TextDecoder().decode(sealed)).not.toContain("secret");
+		expect(await openTranscript(key, "s1", sealed)).toEqual(transcript);
+	});
+
+	it("never opens with another key or for another session", async () => {
+		const key = await importRoomKey(generateRoomKey());
+		const sealed = await sealTranscript(key, transcript);
+		if (sealed === null) throw new Error("expected a sealed transcript");
+		expect(await openTranscript(await importRoomKey(generateRoomKey()), "s1", sealed)).toBeNull();
+		expect(await openTranscript(key, "s2", sealed)).toBeNull();
+	});
+
+	it("skips a transcript over the per-chat cap", async () => {
+		const key = await importRoomKey(generateRoomKey());
+		expect(await sealTranscript(key, transcript, 20)).toBeNull();
+	});
+});
+
+describe("GuestClient on-device copy", () => {
+	const saved: CachedTranscript = { sessionId: "s1", header: HEADER, entries: [entry("c1", "cached")] };
+
+	it("shows the saved copy, marked cached, until the live snapshot replaces it", async () => {
+		const { store, release } = memoryStore(saved);
+		const client = new GuestClient(LINK, "tester", store);
+		await release();
+		let snap = client.getSnapshot();
+		expect(snap.entries).toEqual(saved.entries);
+		expect(snap.cached).toBe(true);
+		expect(snap.phase).not.toBe("live");
+
+		client.applyFrameForTest(welcome(1));
+		expect(client.getSnapshot().entries).toEqual(saved.entries);
+		expect(client.getSnapshot().cached).toBe(true);
+
+		const live = entry("l1", "live");
+		client.applyFrameForTest({ t: "snapshot-chunk", entries: [live], final: true });
+		snap = client.getSnapshot();
+		expect(snap.entries).toEqual([live]);
+		expect(snap.cached).toBe(false);
+		expect(snap.phase).toBe("live");
+	});
+
+	it("ignores a saved copy that arrives after the live snapshot", async () => {
+		const { store, release } = memoryStore(saved);
+		const client = new GuestClient(LINK, "tester", store);
+		const live = entry("l1", "live");
+		client.applyFrameForTest(welcome(1));
+		client.applyFrameForTest({ t: "snapshot-chunk", entries: [live], final: true });
+		await release();
+		expect(client.getSnapshot().entries).toEqual([live]);
+		expect(client.getSnapshot().cached).toBe(false);
+	});
+
+	it("drops a saved copy of another session on welcome", async () => {
+		const { store, release } = memoryStore(saved);
+		const client = new GuestClient(LINK, "tester", store);
+		await release();
+		client.applyFrameForTest(welcome(3, { ...HEADER, id: "other" }));
+		expect(client.getSnapshot().entries).toEqual([]);
+		expect(client.getSnapshot().cached).toBe(false);
+	});
+
+	it("saves the live transcript after changes go quiet, never the saved copy itself", async () => {
+		vi.useFakeTimers();
+		try {
+			const { store, saves, firstSave, release } = memoryStore(saved);
+			const client = new GuestClient(LINK, "tester", store);
+			await release();
+			client.applyFrameForTest(welcome(1));
+			vi.advanceTimersByTime(5_000);
+
+			const live = entry("l1", "live");
+			client.applyFrameForTest({ t: "snapshot-chunk", entries: [live], final: true });
+			vi.advanceTimersByTime(1_000);
+			const next = entry("l2", "next");
+			client.applyFrameForTest({ t: "entry", entry: next });
+			vi.advanceTimersByTime(2_000);
+			await firstSave;
+			// One save, holding both entries: the snapshot's save waited for the entry.
+			expect(saves).toEqual([{ sessionId: "s1", header: HEADER, entries: [live, next] }]);
+		} finally {
+			vi.useRealTimers();
+		}
+	});
+});
