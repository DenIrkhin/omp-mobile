diff --git a/packages/collab-web/src/lib/transcript-cache.ts b/packages/collab-web/src/lib/transcript-cache.ts
new file mode 100644
index 0000000..5fd900b
--- /dev/null
+++ b/packages/collab-web/src/lib/transcript-cache.ts
@@ -0,0 +1,314 @@
+/**
+ * On-device copy of each chat's transcript, kept in IndexedDB so reopening a
+ * chat, or reloading a tab the phone discarded, shows the last transcript at
+ * once while the host's snapshot downloads. The client swaps in the live
+ * snapshot once it completes; the copy is never shown as live.
+ *
+ * Records are keyed by the omp session id (`SessionHeader.id`). An index on the
+ * room id finds a chat's record from its link before the host's `welcome`
+ * names the session. A room mirrors one session for its whole life; a new room
+ * for the same session (new link, new key) overwrites the record on its first
+ * save.
+ *
+ * Each transcript is sealed with the room key (AES-256-GCM, the session id as
+ * additional data), so the stored copy is no more readable than the link. A
+ * record that does not open with the link's key is deleted.
+ *
+ * Every failure (no IndexedDB, quota, a newer schema, a lost connection)
+ * resolves to "no copy", so the page behaves as it does without a cache.
+ */
+import { asStrictBytes } from "@oh-my-pi/pi-utils/bytes";
+import type { SessionEntry, SessionHeader } from "@oh-my-pi/pi-wire";
+
+export interface CachedTranscript {
+	sessionId: string;
+	header: SessionHeader;
+	entries: readonly SessionEntry[];
+}
+
+export interface TranscriptStore {
+	/** The copy saved for this room's session, or null. Never rejects. */
+	load(roomId: string, key: CryptoKey): Promise<CachedTranscript | null>;
+	/** Replaces the copy of `transcript.sessionId`, then evicts over the limits. Never rejects. */
+	save(roomId: string, key: CryptoKey, transcript: CachedTranscript): Promise<void>;
+}
+
+export interface CacheLimits {
+	/** Chats kept, most recently opened first. */
+	maxChats: number;
+	/** Sealed bytes kept across all chats. */
+	maxTotalBytes: number;
+	/** A transcript larger than this (JSON bytes) is not stored, and its old copy is removed. */
+	maxChatBytes: number;
+}
+
+const MB = 1024 * 1024;
+
+/**
+ * 25 MB per chat holds the measured median session (4.6 MB) five times over; a
+ * bigger chat is skipped because each save rebuilds and seals the whole copy.
+ */
+export const CACHE_LIMITS: CacheLimits = { maxChats: 10, maxTotalBytes: 100 * MB, maxChatBytes: 25 * MB };
+
+/** Plaintext index row; the transcript itself lives sealed in its own store. */
+export interface CachedChatInfo {
+	sessionId: string;
+	roomId: string;
+	/** Sealed size in bytes. */
+	bytes: number;
+	/** Last open or save, epoch ms. */
+	usedAt: number;
+}
+
+/**
+ * Session ids to delete so the rest fit `limits`: the most recently used chats
+ * are kept while both the count and the byte total fit; every older one goes.
+ */
+export function chatsToEvict(chats: readonly CachedChatInfo[], limits: CacheLimits = CACHE_LIMITS): string[] {
+	const newestFirst = [...chats].sort((a, b) => b.usedAt - a.usedAt);
+	const evict: string[] = [];
+	let kept = 0;
+	let total = 0;
+	for (const chat of newestFirst) {
+		if (evict.length === 0 && kept < limits.maxChats && total + chat.bytes <= limits.maxTotalBytes) {
+			kept++;
+			total += chat.bytes;
+		} else {
+			evict.push(chat.sessionId);
+		}
+	}
+	return evict;
+}
+
+// ═══════════════════════════════════════════════════════════════════════════
+// Sealing
+// ═══════════════════════════════════════════════════════════════════════════
+
+const AES_ALGORITHM = "AES-GCM";
+const IV_LENGTH = 12;
+const AAD_PREFIX = "omp-collab-transcript-cache:v1:";
+const TEXT_ENCODER = new TextEncoder();
+const TEXT_DECODER = new TextDecoder();
+
+/** Entry JSON, kept per entry object so a save after new entries only stringifies those. */
+const entryJson = new WeakMap<SessionEntry, string>();
+
+/** JSON of the transcript, or null when it is over `maxBytes`. */
+function serializeTranscript(transcript: CachedTranscript, maxBytes: number): string | null {
+	const parts: string[] = [];
+	// UTF-16 length never exceeds UTF-8 bytes, so an over-cap sum is over cap once encoded.
+	let length = 0;
+	for (const entry of transcript.entries) {
+		let json = entryJson.get(entry);
+		if (json === undefined) {
+			json = JSON.stringify(entry);
+			entryJson.set(entry, json);
+		}
+		length += json.length + 1;
+		if (length > maxBytes) return null;
+		parts.push(json);
+	}
+	return `{"header":${JSON.stringify(transcript.header)},"entries":[${parts.join(",")}]}`;
+}
+
+function additionalData(sessionId: string): Uint8Array<ArrayBuffer> {
+	return TEXT_ENCODER.encode(`${AAD_PREFIX}${sessionId}`);
+}
+
+/** `[12B IV][ciphertext+tag]`, or null when the transcript is over `maxBytes`. */
+export async function sealTranscript(
+	key: CryptoKey,
+	transcript: CachedTranscript,
+	maxBytes = CACHE_LIMITS.maxChatBytes,
+): Promise<Uint8Array | null> {
+	const json = serializeTranscript(transcript, maxBytes);
+	if (json === null) return null;
+	const plaintext = TEXT_ENCODER.encode(json);
+	if (plaintext.byteLength > maxBytes) return null;
+	const iv = new Uint8Array(IV_LENGTH);
+	crypto.getRandomValues(iv);
+	const ciphertext = new Uint8Array(
+		await crypto.subtle.encrypt(
+			{ name: AES_ALGORITHM, iv, additionalData: additionalData(transcript.sessionId) },
+			key,
+			plaintext,
+		),
+	);
+	const out = new Uint8Array(IV_LENGTH + ciphertext.byteLength);
+	out.set(iv, 0);
+	out.set(ciphertext, IV_LENGTH);
+	return out;
+}
+
+/** Inverse of {@link sealTranscript}; null for a wrong key, another session's record, or bad bytes. */
+export async function openTranscript(
+	key: CryptoKey,
+	sessionId: string,
+	sealed: Uint8Array,
+): Promise<CachedTranscript | null> {
+	if (sealed.byteLength <= IV_LENGTH) return null;
+	let payload: { header?: SessionHeader; entries?: unknown };
+	try {
+		const plaintext = await crypto.subtle.decrypt(
+			{
+				name: AES_ALGORITHM,
+				iv: asStrictBytes(sealed.subarray(0, IV_LENGTH)),
+				additionalData: additionalData(sessionId),
+			},
+			key,
+			asStrictBytes(sealed.subarray(IV_LENGTH)),
+		);
+		// Authenticated with the room key and this session id, so it is a record sealTranscript wrote.
+		payload = JSON.parse(TEXT_DECODER.decode(plaintext)) as typeof payload;
+	} catch {
+		return null;
+	}
+	const { header, entries } = payload;
+	if (header?.id !== sessionId || !Array.isArray(entries)) return null;
+	return { sessionId, header, entries: entries as SessionEntry[] };
+}
+
+// ═══════════════════════════════════════════════════════════════════════════
+// IndexedDB
+// ═══════════════════════════════════════════════════════════════════════════
+
+const DB_NAME = "omp-collab-transcripts";
+const DB_VERSION = 1;
+/** {@link CachedChatInfo} rows, keyed by session id, indexed by room id. */
+const CHATS = "chats";
+const ROOM_INDEX = "roomId";
+/** Sealed transcripts, keyed by session id. */
+const SEALED = "sealed";
+
+let database: Promise<IDBDatabase | null> | null = null;
+
+function openDatabase(): Promise<IDBDatabase | null> {
+	if (database !== null) return database;
+	const { promise, resolve } = Promise.withResolvers<IDBDatabase | null>();
+	database = promise;
+	try {
+		const request = indexedDB.open(DB_NAME, DB_VERSION);
+		request.onupgradeneeded = () => {
+			const db = request.result;
+			// The store is a disposable cache: any older layout starts over.
+			for (const name of Array.from(db.objectStoreNames)) db.deleteObjectStore(name);
+			db.createObjectStore(CHATS, { keyPath: "sessionId" }).createIndex(ROOM_INDEX, "roomId");
+			db.createObjectStore(SEALED);
+		};
+		request.onsuccess = () => {
+			const db = request.result;
+			db.onversionchange = () => {
+				db.close();
+				database = null;
+			};
+			resolve(db);
+		};
+		// Private mode, a newer schema, a broken store: run without a cache.
+		request.onerror = () => resolve(null);
+	} catch {
+		// No IndexedDB at all (old browser, test runtime) or access denied.
+		resolve(null);
+	}
+	return promise;
+}
+
+/** Drops the connection after a failed transaction; WebKit can lose it while a tab sleeps. */
+function forgetDatabase(): void {
+	const stale = database;
+	database = null;
+	void stale?.then(db => db?.close());
+}
+
+/** Runs `body` in one transaction over both stores; a closed connection rejects instead of throwing. */
+async function transact(
+	db: IDBDatabase,
+	mode: IDBTransactionMode,
+	body: (chats: IDBObjectStore, sealed: IDBObjectStore) => void,
+): Promise<void> {
+	const { promise, resolve, reject } = Promise.withResolvers<void>();
+	const tx = db.transaction([CHATS, SEALED], mode);
+	tx.oncomplete = () => resolve();
+	tx.onerror = () => reject(tx.error);
+	tx.onabort = () => reject(tx.error);
+	body(tx.objectStore(CHATS), tx.objectStore(SEALED));
+	return promise;
+}
+
+function deleteChat(chats: IDBObjectStore, sealed: IDBObjectStore, sessionId: string): void {
+	chats.delete(sessionId);
+	sealed.delete(sessionId);
+}
+
+async function readRoom(db: IDBDatabase, roomId: string): Promise<{ info: CachedChatInfo; sealed: Uint8Array } | null> {
+	let found: { info: CachedChatInfo; sealed: Uint8Array } | null = null;
+	await transact(db, "readonly", (chats, sealed) => {
+		const infoRequest = chats.index(ROOM_INDEX).get(roomId);
+		infoRequest.onsuccess = () => {
+			// The schema version wipes older layouts, so every row is a CachedChatInfo.
+			const info = infoRequest.result as CachedChatInfo | undefined;
+			if (info === undefined) return;
+			const sealedRequest = sealed.get(info.sessionId);
+			sealedRequest.onsuccess = () => {
+				const bytes: unknown = sealedRequest.result;
+				if (bytes instanceof Uint8Array) found = { info, sealed: bytes };
+			};
+		};
+	});
+	return found;
+}
+
+/** The IndexedDB store the page uses; shared by every client on the page. */
+export const browserTranscriptStore: TranscriptStore = {
+	async load(roomId, key) {
+		try {
+			const db = await openDatabase();
+			if (db === null) return null;
+			const found = await readRoom(db, roomId);
+			if (found === null) return null;
+			const { info } = found;
+			const transcript = await openTranscript(key, info.sessionId, found.sealed);
+			if (transcript === null) {
+				await transact(db, "readwrite", (chats, sealed) => deleteChat(chats, sealed, info.sessionId));
+				return null;
+			}
+			// Mark it most recently used; a failed mark only affects eviction order.
+			transact(db, "readwrite", chats => {
+				chats.put({ ...info, usedAt: Date.now() } satisfies CachedChatInfo);
+			}).catch(forgetDatabase);
+			return transcript;
+		} catch {
+			forgetDatabase();
+			return null;
+		}
+	},
+
+	async save(roomId, key, transcript) {
+		try {
+			const db = await openDatabase();
+			if (db === null) return;
+			const bytes = await sealTranscript(key, transcript);
+			await transact(db, "readwrite", (chats, sealed) => {
+				if (bytes === null) {
+					deleteChat(chats, sealed, transcript.sessionId);
+					return;
+				}
+				const info: CachedChatInfo = {
+					sessionId: transcript.sessionId,
+					roomId,
+					bytes: bytes.byteLength,
+					usedAt: Date.now(),
+				};
+				chats.put(info);
+				sealed.put(bytes, info.sessionId);
+				const all = chats.getAll();
+				all.onsuccess = () => {
+					for (const sessionId of chatsToEvict(all.result as CachedChatInfo[])) {
+						deleteChat(chats, sealed, sessionId);
+					}
+				};
+			});
+		} catch {
+			forgetDatabase();
+		}
+	},
+};
