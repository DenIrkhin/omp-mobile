@@ -0,0 +1,56 @@
+/**
+ * Turns a picked or pasted image file into an `ImageContent` block for a guest prompt.
+ *
+ * The host saves a guest prompt as one session entry and replicates it back to every guest;
+ * an entry over 1 MiB reaches guests as a placeholder instead (MAX_REPLICATED_PAYLOAD_BYTES
+ * in coding-agent/src/collab/replication-shrink.ts). So every image is re-encoded as a JPEG
+ * of at most MAX_BASE64_CHARS, and MAX_PROMPT_IMAGES of them still fit one entry.
+ */
+import type { ImageContent } from "@oh-my-pi/pi-wire";
+
+export const MAX_PROMPT_IMAGES = 4;
+const MAX_BASE64_CHARS = 220_000;
+/** Claude scales larger images down to about 1.15 megapixels anyway; sending more only costs bytes. */
+const MAX_PIXELS = 1_150_000;
+const QUALITIES = [0.85, 0.75, 0.65, 0.55];
+/** Each further attempt shrinks both sides by this factor when no quality fits the budget. */
+const SHRINK = 0.75;
+const MAX_ATTEMPTS = 4;
+const JPEG_PREFIX = "data:image/jpeg;base64,";
+
+async function decode(file: Blob): Promise<HTMLImageElement> {
+	const url = URL.createObjectURL(file);
+	try {
+		const img = new Image();
+		img.src = url;
+		await img.decode().catch(() => {
+			throw new Error("this browser cannot read that image format");
+		});
+		return img;
+	} finally {
+		URL.revokeObjectURL(url);
+	}
+}
+
+export async function prepareImage(file: Blob): Promise<ImageContent> {
+	const img = await decode(file);
+	const { naturalWidth: width, naturalHeight: height } = img;
+	if (width === 0 || height === 0) throw new Error("the image is empty");
+	let scale = Math.min(1, Math.sqrt(MAX_PIXELS / (width * height)));
+	for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt++, scale *= SHRINK) {
+		const canvas = document.createElement("canvas");
+		canvas.width = Math.max(1, Math.round(width * scale));
+		canvas.height = Math.max(1, Math.round(height * scale));
+		const ctx = canvas.getContext("2d");
+		if (!ctx) throw new Error("this browser cannot draw images");
+		// JPEG has no transparency: paint white first so transparent PNG areas do not turn black.
+		ctx.fillStyle = "#fff";
+		ctx.fillRect(0, 0, canvas.width, canvas.height);
+		ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
+		for (const quality of QUALITIES) {
+			const data = canvas.toDataURL("image/jpeg", quality).slice(JPEG_PREFIX.length);
+			if (data.length <= MAX_BASE64_CHARS) return { type: "image", data, mimeType: "image/jpeg" };
+		}
+	}
+	throw new Error("the image is too large to send");
+}
